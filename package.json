{
	"name": "@febkosq8/arc",
	"description": "A React components library for febkosq8",
	"private": false,
	"version": "0.8.0",
	"type": "module",
	"main": "./dist/arc.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/arc.js"
		},
		"./styles.css": "./components/index.css"
	},
	"files": [
		"dist",
		"components/index.css"
	],
	"homepage": "https://www.npmjs.com/package/@febkosq8/arc",
	"repository": "https://github.com/febkosq8/arc",
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"build": "vite build",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"prettier": "prettier --write .",
		"push-npm": "npm publish --access public",
		"prepublishOnly": "pnpm run build"
	},
	"peerDependencies": {
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@rinzai/zen": "0.14.0",
		"@tanstack/match-sorter-utils": "9.2.6",
		"@tanstack/react-table": "9.3.1",
		"luxon": "3.7.2",
		"react-icons": "5.7.0"
	},
	"devDependencies": {
		"@storybook/addon-docs": "10.6.2",
		"@storybook/react-vite": "10.6.2",
		"@tailwindcss/postcss": "4.3.3",
		"@types/luxon": "3.7.6",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript/typescript6": "6.0.2",
		"@vitejs/plugin-react": "6.1.2",
		"eslint": "10.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-css-order": "2.2.0",
		"prettier-plugin-organize-attributes": "1.0.0",
		"prettier-plugin-organize-imports": "4.3.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"storybook": "10.6.2",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"unplugin-dts": "1.1.2",
		"vite": "8.3.4"
	}
}
